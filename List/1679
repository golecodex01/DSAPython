class Solution(object):
    def maxOperations(self, nums, k):
        count = 0
        freq = {}

        for num in nums:
            target = k - num

            if target in freq and freq[target] > 0:
                count += 1
                freq[target] -= 1
            else:
                freq[num] = freq.get(num, 0) + 1

        return count
