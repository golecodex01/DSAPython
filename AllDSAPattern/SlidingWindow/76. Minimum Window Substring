from collections import Counter

class Solution:
    def minWindow(self, s, t):
        if not s or not t:
            return ""

        need = Counter(t)
        left = 0
        required = len(t)
        start = 0
        minLen = float('inf')

        for right in range(len(s)):
            if need[s[right]] > 0:
                required -= 1

            need[s[right]] -= 1

            while required == 0:
                if right - left + 1 < minLen:
                    minLen = right - left + 1
                    start = left

                need[s[left]] += 1

                if need[s[left]] > 0:
                    required += 1

                left += 1

        return "" if minLen == float('inf') else s[start:start + minLen]
